<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Customer Portal Invoice Isolation: Customers can ONLY see their own invoices -->
        <record id="rule_portal_customer_invoice_isolation" model="ir.rule">
            <field name="name">Portal Customer: Own Invoices Only</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">[('partner_id', 'child_of', [user.partner_id.commercial_partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>

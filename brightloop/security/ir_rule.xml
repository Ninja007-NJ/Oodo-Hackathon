<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Customer Portal Invoice Isolation: Customers can ONLY see their own invoices -->
        <record id="rule_portal_customer_invoice_isolation" model="ir.rule">
            <field name="name">Portal Customer: Own Invoices Only</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">[('partner_id', 'child_of', [user.partner_id.commercial_partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Customer Portal Subscription Isolation: Customers can ONLY see their own subscriptions -->
        <record id="rule_portal_customer_subscription_isolation" model="ir.rule">
            <field name="name">Portal Customer: Own Subscriptions Only</field>
            <field name="model_id" ref="model_brightloop_subscription"/>
            <field name="domain_force">[('customer_id', 'child_of', [user.partner_id.commercial_partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Customer Portal Subscription Line Isolation -->
        <record id="rule_portal_customer_subscription_line_isolation" model="ir.rule">
            <field name="name">Portal Customer: Own Subscription Lines Only</field>
            <field name="model_id" ref="model_brightloop_subscription_line"/>
            <field name="domain_force">[('subscription_id.customer_id', 'child_of', [user.partner_id.commercial_partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Internal Staff & Admin Subscription Multi-Company Rule -->
        <record id="rule_brightloop_subscription_comp_rule" model="ir.rule">
            <field name="name">Brightloop Subscription Company Rule</field>
            <field name="model_id" ref="model_brightloop_subscription"/>
            <field name="domain_force">['|', ('customer_id.company_id', '=', False), ('customer_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('brightloop.group_brightloop_user'))]"/>
        </record>
    </data>
</odoo>

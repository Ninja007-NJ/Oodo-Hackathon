<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Subscription Tree View -->
    <record id="view_brightloop_subscription_tree" model="ir.ui.view">
        <field name="name">brightloop.subscription.tree</field>
        <field name="model">brightloop.subscription</field>
        <field name="arch" type="xml">
            <tree string="Subscriptions"
                  decoration-info="state == 'quotation'"
                  decoration-primary="state == 'confirmed'"
                  decoration-success="state == 'active' and not is_paused"
                  decoration-warning="is_paused"
                  decoration-danger="state == 'closed'">
                <field name="number"/>
                <field name="customer_id"/>
                <field name="plan_id"/>
                <field name="start_date"/>
                <field name="expiry_date"/>
                <field name="next_billing_date"/>
                <field name="currency_id" invisible="1"/>
                <field name="amount_total" widget="monetary"/>
                <field name="is_paused" widget="boolean" optional="show"/>
                <field name="is_renewed" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'quotation'"
                       decoration-primary="state == 'confirmed'"
                       decoration-success="state == 'active'"
                       decoration-danger="state == 'closed'"
                       decoration-muted="state == 'draft'"/>
            </tree>
        </field>
    </record>

    <!-- Subscription Form View -->
    <record id="view_brightloop_subscription_form" model="ir.ui.view">
        <field name="name">brightloop.subscription.form</field>
        <field name="model">brightloop.subscription</field>
        <field name="arch" type="xml">
            <form string="Subscription">
                <header>
                    <button name="action_to_quotation" string="Send Quotation" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary" invisible="state != 'quotation'"/>
                    <button name="action_activate" string="Activate" type="object"
                            class="btn-success" invisible="state != 'confirmed'"/>
                    <button name="action_pause" string="Pause / Resume" type="object"
                            class="btn-secondary" invisible="state != 'active'"/>
                    <button name="action_close" string="Close Subscription" type="object"
                            class="btn-outline-danger" invisible="state != 'active'"/>
                    <button name="action_renew" string="Renew Subscription" type="object"
                            class="btn-outline-primary" invisible="state not in ('active', 'closed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,quotation,confirmed,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="number" class="oe_edit_only"/>
                        <h1><field name="number" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Customer &amp; Plan">
                            <field name="customer_id" widget="res_partner_many2one" context="{'show_address': 1}" options="{'always_reload': True}"/>
                            <field name="plan_id"/>
                            <field name="template_id" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Contract Schedule">
                            <field name="start_date"/>
                            <field name="expiry_date"/>
                            <field name="next_billing_date"/>
                            <field name="payment_term_id"/>
                            <field name="is_paused" readonly="1" invisible="not is_paused"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Subscription Lines" name="lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="variant_info"/>
                                    <field name="qty"/>
                                    <field name="unit_price"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="discount_id"/>
                                    <field name="amount" sum="Total Untaxed"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_untaxed" widget="monetary"/>
                                <field name="amount_tax" widget="monetary"/>
                                <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                    <label for="amount_total"/>
                                </div>
                                <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary"/>
                            </group>
                        </page>
                        <page string="Billed Periods" name="billed_periods">
                            <field name="billing_period_ids" readonly="1">
                                <tree>
                                    <field name="period_start"/>
                                    <field name="period_end"/>
                                    <field name="invoice_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Other Info" name="other_info">
                            <group>
                                <field name="is_renewed" readonly="1"/>
                                <field name="close_date" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Subscription Search View -->
    <record id="view_brightloop_subscription_search" model="ir.ui.view">
        <field name="name">brightloop.subscription.search</field>
        <field name="model">brightloop.subscription</field>
        <field name="arch" type="xml">
            <search string="Search Subscriptions">
                <field name="number"/>
                <field name="customer_id"/>
                <field name="plan_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Quotations" name="quotations" domain="[('state', '=', 'quotation')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Paused" name="paused" domain="[('is_paused', '=', True)]"/>
                <filter string="Closed" name="closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter string="Next Billing Due" name="billing_due" domain="[('state', '=', 'active'), ('next_billing_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Customer" name="group_customer" domain="[]" context="{'group_by': 'customer_id'}"/>
                    <filter string="Plan" name="group_plan" domain="[]" context="{'group_by': 'plan_id'}"/>
                    <filter string="Status" name="group_status" domain="[]" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Subscription Action -->
    <record id="action_brightloop_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">brightloop.subscription</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_brightloop_subscription_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Manage your recurring subscriptions from quote to active billing!
            </p>
        </field>
    </record>
</odoo>

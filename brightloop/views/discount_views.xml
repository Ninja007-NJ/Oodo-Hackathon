<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Discount Tree View -->
    <record id="view_brightloop_discount_tree" model="ir.ui.view">
        <field name="name">brightloop.discount.tree</field>
        <field name="model">brightloop.discount</field>
        <field name="arch" type="xml">
            <tree string="Discount Rules" decoration-muted="not active">
                <field name="name"/>
                <field name="type"/>
                <field name="value"/>
                <field name="scope"/>
                <field name="min_purchase"/>
                <field name="min_qty"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="used_count"/>
                <field name="usage_limit"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Discount Form View -->
    <record id="view_brightloop_discount_form" model="ir.ui.view">
        <field name="name">brightloop.discount.form</field>
        <field name="model">brightloop.discount</field>
        <field name="arch" type="xml">
            <form string="Discount Rule">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. 10% Volume Discount, Welcome 500 Off"/></h1>
                    </div>
                    <group>
                        <group string="Deduction Calculation">
                            <field name="type"/>
                            <field name="value"/>
                            <field name="scope"/>
                            <field name="product_ids" widget="many2many_tags" invisible="scope != 'product'"/>
                        </group>
                        <group string="Eligibility &amp; Limits">
                            <field name="min_purchase"/>
                            <field name="min_qty"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <label for="used_count" string="Usage"/>
                            <div class="o_row">
                                <field name="used_count"/> / <field name="usage_limit"/>
                                <span class="text-muted ms-2">(0 = unlimited)</span>
                            </div>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Discount Action -->
    <record id="action_brightloop_discount" model="ir.actions.act_window">
        <field name="name">Discount Rules</field>
        <field name="res_model">brightloop.discount</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create promotional discount rules that automatically apply during recurring billing runs!
            </p>
        </field>
    </record>
</odoo>

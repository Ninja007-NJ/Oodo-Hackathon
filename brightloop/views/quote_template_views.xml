<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Quote Template Tree View -->
    <record id="view_brightloop_quote_template_tree" model="ir.ui.view">
        <field name="name">brightloop.quote.template.tree</field>
        <field name="model">brightloop.quote.template</field>
        <field name="arch" type="xml">
            <tree string="Quotation Templates" decoration-muted="not active">
                <field name="name"/>
                <field name="plan_id"/>
                <field name="validity_days"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Quote Template Form View -->
    <record id="view_brightloop_quote_template_form" model="ir.ui.view">
        <field name="name">brightloop.quote.template.form</field>
        <field name="model">brightloop.quote.template</field>
        <field name="arch" type="xml">
            <form string="Quotation Template">
                <header>
                    <button name="action_create_subscription" string="New Subscription From Template" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Standard SaaS Package"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="plan_id"/>
                            <field name="validity_days"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Preset Product Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="qty"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Quote Template Action -->
    <record id="action_brightloop_quote_template" model="ir.actions.act_window">
        <field name="name">Quotation Templates</field>
        <field name="res_model">brightloop.quote.template</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Set up reusable quotation templates with plans and default product lines!
            </p>
        </field>
    </record>
</odoo>

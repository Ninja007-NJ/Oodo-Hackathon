<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Subscription Number -->
        <record id="seq_brightloop_subscription" model="ir.sequence">
            <field name="name">Brightloop Subscription Sequence</field>
            <field name="code">brightloop.subscription</field>
            <field name="prefix">SUB/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Daily Automated Cron for Recurring Billing -->
        <record id="ir_cron_brightloop_daily_billing" model="ir.cron">
            <field name="name">Brightloop: Daily Recurring Billing Engine</field>
            <field name="model_id" ref="model_brightloop_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_recurring_billing()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. Taxes -->
        <record id="tax_gst_18" model="account.tax">
            <field name="name">GST 18%</field>
            <field name="type_tax_use">sale</field>
            <field name="amount">18.0</field>
            <field name="amount_type">percent</field>
        </record>

        <record id="tax_zero_0" model="account.tax">
            <field name="name">GST 0% / Tax Exempt</field>
            <field name="type_tax_use">sale</field>
            <field name="amount">0.0</field>
            <field name="amount_type">percent</field>
        </record>

        <!-- 2. Brand Attribute for Product Variants -->
        <record id="product_attribute_brand" model="product.attribute">
            <field name="name">Brand</field>
            <field name="create_variant">always</field>
        </record>

        <record id="attr_val_standard" model="product.attribute.value">
            <field name="name">Standard</field>
            <field name="attribute_id" ref="product_attribute_brand"/>
            <field name="sequence">1</field>
        </record>

        <record id="attr_val_odoo" model="product.attribute.value">
            <field name="name">Odoo</field>
            <field name="attribute_id" ref="product_attribute_brand"/>
            <field name="sequence">2</field>
        </record>

        <record id="attr_val_zoho" model="product.attribute.value">
            <field name="name">Zoho</field>
            <field name="attribute_id" ref="product_attribute_brand"/>
            <field name="sequence">3</field>
        </record>

        <!-- 3. Products -->
        <!-- Brightloop CRM with Brand Variants -->
        <record id="product_tmpl_brightloop_crm" model="product.template">
            <field name="name">Brightloop CRM</field>
            <field name="type">service</field>
            <field name="list_price">1500.0</field>
            <field name="standard_price">400.0</field>
            <field name="taxes_id" eval="[(6, 0, [ref('tax_gst_18')])]"/>
            <field name="description">Flagship CRM and pipeline automation suite.</field>
            <field name="attribute_line_ids" eval="[(0, 0, {
                'attribute_id': ref('product_attribute_brand'),
                'value_ids': [(6, 0, [ref('attr_val_standard'), ref('attr_val_odoo'), ref('attr_val_zoho')])]
            })]"/>
        </record>

        <!-- Variant Price Extras (Odoo adds 560, Zoho adds 300) -->
        <record id="tmpl_attr_val_odoo" model="product.template.attribute.value">
            <field name="attribute_id" ref="product_attribute_brand"/>
            <field name="product_attribute_value_id" ref="attr_val_odoo"/>
            <field name="product_tmpl_id" ref="product_tmpl_brightloop_crm"/>
            <field name="price_extra">560.0</field>
        </record>

        <record id="tmpl_attr_val_zoho" model="product.template.attribute.value">
            <field name="attribute_id" ref="product_attribute_brand"/>
            <field name="product_attribute_value_id" ref="attr_val_zoho"/>
            <field name="product_tmpl_id" ref="product_tmpl_brightloop_crm"/>
            <field name="price_extra">300.0</field>
        </record>

        <!-- Additional Standalone Products -->
        <record id="product_tmpl_brightloop_helpdesk" model="product.template">
            <field name="name">Brightloop Helpdesk</field>
            <field name="type">service</field>
            <field name="list_price">1200.0</field>
            <field name="standard_price">300.0</field>
            <field name="taxes_id" eval="[(6, 0, [ref('tax_gst_18')])]"/>
        </record>

        <record id="product_tmpl_extra_seat" model="product.template">
            <field name="name">Extra Seat Add-on</field>
            <field name="type">service</field>
            <field name="list_price">250.0</field>
            <field name="standard_price">50.0</field>
            <field name="taxes_id" eval="[(6, 0, [ref('tax_gst_18')])]"/>
        </record>

        <record id="product_tmpl_priority_support" model="product.template">
            <field name="name">Priority Support Add-on</field>
            <field name="type">service</field>
            <field name="list_price">500.0</field>
            <field name="standard_price">100.0</field>
            <field name="taxes_id" eval="[(6, 0, [ref('tax_gst_18')])]"/>
        </record>

        <!-- 4. Subscription Plans -->
        <record id="plan_starter_monthly" model="brightloop.plan">
            <field name="name">Starter Monthly</field>
            <field name="billing_period">monthly</field>
            <field name="price">1500.0</field>
            <field name="min_qty">1</field>
            <field name="auto_close" eval="False"/>
            <field name="closable" eval="True"/>
            <field name="pausable" eval="True"/>
            <field name="renewable" eval="True"/>
            <field name="description">Ideal for small growing businesses seeking full recurring billing agility.</field>
        </record>

        <record id="plan_business_yearly" model="brightloop.plan">
            <field name="name">Business Yearly</field>
            <field name="billing_period">yearly</field>
            <field name="price">15000.0</field>
            <field name="min_qty">5</field>
            <field name="auto_close" eval="True"/>
            <field name="closable" eval="False"/>
            <field name="pausable" eval="False"/>
            <field name="renewable" eval="True"/>
            <field name="description">Annual committed contract with auto-close protection upon contract expiration.</field>
        </record>

        <record id="plan_weekly_trial" model="brightloop.plan">
            <field name="name">Weekly Trial</field>
            <field name="billing_period">weekly</field>
            <field name="price">0.0</field>
            <field name="min_qty">1</field>
            <field name="auto_close" eval="True"/>
            <field name="closable" eval="True"/>
            <field name="pausable" eval="True"/>
            <field name="renewable" eval="False"/>
            <field name="description">7-day free trial tier with pause capabilities.</field>
        </record>

        <record id="plan_daily_test" model="brightloop.plan">
            <field name="name">Daily Test</field>
            <field name="billing_period">daily</field>
            <field name="price">100.0</field>
            <field name="min_qty">1</field>
            <field name="auto_close" eval="False"/>
            <field name="closable" eval="True"/>
            <field name="pausable" eval="True"/>
            <field name="renewable" eval="True"/>
            <field name="description">High-frequency daily billing for micro-services and testing.</field>
        </record>

        <!-- 5. Discounts -->
        <record id="discount_volume_10" model="brightloop.discount">
            <field name="name">10% Volume Discount (Qty &gt;= 20)</field>
            <field name="type">percent</field>
            <field name="value">10.0</field>
            <field name="min_qty">20</field>
            <field name="scope">subscription</field>
        </record>

        <record id="discount_fixed_500" model="brightloop.discount">
            <field name="name">Flat 500 Off (Limit 3 Uses)</field>
            <field name="type">fixed</field>
            <field name="value">500.0</field>
            <field name="min_purchase">1000.0</field>
            <field name="usage_limit">3</field>
            <field name="used_count">0</field>
            <field name="scope">subscription</field>
        </record>

        <record id="discount_expired" model="brightloop.discount">
            <field name="name">Expired Launch Promo 25%</field>
            <field name="type">percent</field>
            <field name="value">25.0</field>
            <field name="start_date">2024-01-01</field>
            <field name="end_date">2024-01-31</field>
            <field name="scope">subscription</field>
        </record>

        <!-- 6. Quotation Templates -->
        <record id="quote_template_standard" model="brightloop.quote.template">
            <field name="name">Standard SaaS Package</field>
            <field name="plan_id" ref="plan_starter_monthly"/>
            <field name="validity_days">30</field>
        </record>

        <!-- 7. Demo Partners & Users -->
        <record id="partner_staff_alex" model="res.partner">
            <field name="name">Alex Rivers (Staff)</field>
            <field name="email">staff.alex@brightloop.test</field>
            <field name="is_company" eval="False"/>
        </record>

        <record id="user_staff_alex" model="res.users">
            <field name="name">Alex Rivers (Staff)</field>
            <field name="login">staff.alex@brightloop.test</field>
            <field name="email">staff.alex@brightloop.test</field>
            <field name="partner_id" ref="partner_staff_alex"/>
            <field name="groups_id" eval="[(6, 0, [ref('base.group_user'), ref('brightloop.group_brightloop_user')])]"/>
        </record>

        <record id="partner_cust_alpha" model="res.partner">
            <field name="name">Acme Software Corp</field>
            <field name="email">billing@acmesoftware.test</field>
            <field name="is_company" eval="True"/>
        </record>

        <record id="user_cust_alpha" model="res.users">
            <field name="name">Acme Software (Portal User)</field>
            <field name="login">billing@acmesoftware.test</field>
            <field name="email">billing@acmesoftware.test</field>
            <field name="partner_id" ref="partner_cust_alpha"/>
            <field name="groups_id" eval="[(6, 0, [ref('base.group_portal')])]"/>
        </record>

        <record id="partner_cust_beta" model="res.partner">
            <field name="name">Beta Enterprises LLC</field>
            <field name="email">finance@betaenterprises.test</field>
            <field name="is_company" eval="True"/>
        </record>

        <record id="user_cust_beta" model="res.users">
            <field name="name">Beta Enterprises (Portal User)</field>
            <field name="login">finance@betaenterprises.test</field>
            <field name="email">finance@betaenterprises.test</field>
            <field name="partner_id" ref="partner_cust_beta"/>
            <field name="groups_id" eval="[(6, 0, [ref('base.group_portal')])]"/>
        </record>
    </data>
</odoo>
